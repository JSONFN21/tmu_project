# Copy to .streamlit/secrets.toml for local use. Never commit real credentials.
SN_USERNAME = "your-servicenow-username"
SN_PASSWORD = "your-servicenow-password"
SN_ENDPOINT = "https://help.torontomu.ca/api/now/table/incident"

# Optional; defaults to .data/servicenow_incidents.parquet
# SN_CACHE_PATH = ".data/servicenow_incidents.parquet"

# Production: read the scheduled snapshot from BigQuery instead of local disk.
# DATA_BACKEND = "bigquery"
# BQ_PROJECT = "your-google-cloud-project-id"
# BQ_DATASET = "ccs_analytics"
# BQ_TABLE = "incidents"
